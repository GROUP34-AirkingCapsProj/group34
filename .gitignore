# OS
.DS_Store
Thumbs.db

# Secrets (keep *.example tracked)
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
back-end/.env
back-end/.env.backup
back-end/.env.production
back-end/.env.pgtest

# Data exports from `php artisan data:transfer --sql`. These hold real business
# data -- password hashes, customer records -- and must never be committed. The
# baseline schema in back-end/database/schema/ is a different thing and stays
# tracked.
airking-data*.sql
back-end/airking-data*.sql
back-end/storage/data-transfer/

# Dependencies
frontend/node_modules/
back-end/vendor/
back-end/scripts/node_modules/

# Builds
frontend/build/
back-end/public/build/
back-end/public/hot

# Laravel / storage
back-end/storage/*.key

# Local SQLite (use migrations on each environment)
back-end/database/*.sqlite
back-end/database/*.sqlite-journal

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.phpunit.result.cache

# IDE
.idea/
*.swp
*.swo

# Local test environment (points at airkingV5_test)
back-end/.env.testing

# DB backups / dumps (data, not source)
/db_backups/

# Local Claude settings (machine-specific)
.claude/settings.local.json

# Brainstorming companion scratch (mockups, session state)
.superpowers/
backups/

# Database dumps — these carry real users, bcrypt hashes, Sanctum tokens and
# session rows. Keep them on disk as the deploy baseline; never in the repo.
/*.sql
back-end/airking
back-end/database/*.sqlite

# One-off dev/debug scripts (seeders, token minters, phase test harnesses).
# Not part of the app; back-end/scripts/phase5_tests.php held a live token.
# Trailing /* not /: git does not descend into an excluded directory, so a
# negation inside one never applies. Excluding the contents keeps the negations
# below working.
back-end/scripts/*
# ...except the operational scripts the docs tell you to run. Both read PG_*
# from .env at runtime and neither prints a password, so the reason this
# directory is ignored does not apply to them.
!back-end/scripts/check-aiven.ps1
!back-end/scripts/backup-aiven.ps1
back-end/tinker_tmp.php
