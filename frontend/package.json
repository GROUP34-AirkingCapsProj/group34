        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "vite": "^8.3.1",
        "whatwg-fetch": "^3.6.20"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
