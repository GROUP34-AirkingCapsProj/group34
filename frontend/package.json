    "scripts": {
        "start": "vite",
        "start:lan": "vite --host 0.0.0.0",
        "build": "vite build",
        "serve:build": "npx --yes serve -s build -l 5000",
        "serve:build:lan": "npx --yes serve -s build -l 5000 --no-clipboard",
        "demo": "npm run build && npm run serve:build",
        "test": "jest",
        "dev": "concurrently -k -n api,reverb,web -c \"#93c5fd,#fb7185,#86efac\" \"cd ../back-end && php artisan serve --host=0.0.0.0 --port=8000\" \"cd ../back-end && php artisan reverb:start --host=0.0.0.0 --port=8080\" \"npm start\"",
        "dev:lan": "concurrently -k -n api,reverb,web -c \"#93c5fd,#fb7185,#86efac\" \"cd ../back-end && php artisan serve --host=0.0.0.0 --port=8000\" \"cd ../back-end && php artisan reverb:start --host=0.0.0.0 --port=8080\" \"npm run start:lan\"",
        "preview": "vite preview --port 5000",
        "test:watch": "jest --watch"
    },
    "devDependencies": {
        "@babel/core": "^8.0.6",
        "@babel/preset-env": "^8.0.6",
        "@babel/preset-react": "^8.0.1",
        "@vitejs/plugin-react": "^6.1.1",
        "babel-jest": "^30.5.2",
        "concurrently": "^9.1.0",
