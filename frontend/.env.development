# Dev server is plain HTTP only. Do NOT open https:// — the browser will time out (ERR_TIMED_OUT).
# Desktop:  http://localhost:3000/admin/approval-queue   (hyphen, no space in the path)
# Phone:    http://<YOUR_PC_LAN_IP>:3000/...  (same Wi‑Fi; use http unless API also has HTTPS)
# Backend for phones must listen on all interfaces, e.g. from back-end: composer run serve-lan

# API port used when the app derives http://<same-host-as-page>:PORT/api.
# Read at runtime by admin/services/api.js — keep this one.
REACT_APP_API_PORT=8000
# REACT_APP_API_HTTPS=true   # only if your API is served with HTTPS on the LAN host

# --- Settings that used to live here now belong to Vite (see vite.config.mjs) ---
# HOST=0.0.0.0                      -> server.host: true   (phones on the same Wi‑Fi)
# DANGEROUSLY_DISABLE_HOST_CHECK    -> not needed; Vite permits LAN IP hosts
# GENERATE_SOURCEMAP=false          -> build.sourcemap: false
# HTTPS=false                       -> Vite serves HTTP unless server.https is set
# Only REACT_APP_*-prefixed vars reach the browser bundle (envPrefix in vite.config.mjs).
