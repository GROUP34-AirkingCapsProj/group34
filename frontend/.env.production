# Production build settings (used by `npm run build`, NOT by `npm start`).
#
# Leaving REACT_APP_API_URL empty makes the app auto-derive the API base from the
# page's own host on port 80 -> http://<same-host>/api. Combined with the Apache
# vhost that serves the SPA and routes /api to Laravel on port 80, this means:
#   - LAN / mobile (http://<PC-IP>/)      -> API http://<PC-IP>/api   (same origin)
#   - localhost (http://localhost/)       -> API http://127.0.0.1/api (CORS-allowed)
# No hardcoded IP or dev port (:8000) gets baked into the production bundle.
REACT_APP_API_URL=
REACT_APP_API_PORT=80

# Do not ship source maps to clients.
GENERATE_SOURCEMAP=false
