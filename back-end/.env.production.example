# =============================================================================
# Airking Inventory — PRODUCTION environment template
#
# Target stack: Render (Docker) + Aiven PostgreSQL + Brevo SMTP.
#
# Copy the keys below into the Render service's Environment tab. Do NOT commit a
# filled-in copy of this file — `.env.production` is git-ignored for that reason.
# Every value written as <angle brackets> must be replaced.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Airking Inventory"
APP_ENV=production

# REQUIRED. Generate once and keep it forever:
#     php artisan key:generate --show
# It must start with "base64:". Changing it makes every previously encrypted
# column and every issued session cookie permanently unreadable — so set it
# before the first deploy and never rotate it casually.
APP_KEY=

# Never true in production: debug pages leak the environment, including the
# database password, to anyone who triggers an error.
APP_DEBUG=false

# The API's own public URL (Render gives you one, e.g. https://<svc>.onrender.com).
# Used for signed URLs, password-reset links and queued mail.
APP_URL=https://<your-api-service>.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
# REQUIRED. The single canonical origin the React app is served from. Parsed by
# config/cors.php; scheme is mandatory, a trailing slash is tolerated.
#     e.g. https://airking-inventory.vercel.app
FRONTEND_URL=https://<your-frontend-domain>

# Optional extras (preview deploys, a second custom domain), comma-separated.
# Do NOT put a wildcard here: `supports_credentials` is on, so any origin listed
# can make authenticated cross-origin calls to this API.
CORS_ALLOWED_ORIGINS=

# Cookie domain shared by API and frontend, for Sanctum's stateful SPA auth.
# Leave both blank if the frontend authenticates with bearer tokens instead.
SANCTUM_STATEFUL_DOMAINS=<your-frontend-domain>
SESSION_DOMAIN=

# -----------------------------------------------------------------------------
# Database — Aiven PostgreSQL
# -----------------------------------------------------------------------------
# Aiven's console shows these under Service > Connection information.
DB_CONNECTION=pgsql
DB_HOST=<service>-<project>.<region>.aivencloud.com
DB_PORT=<aiven-port>          # Aiven assigns a non-default port, not 5432
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=<aiven-password>
DB_CHARSET=utf8
DB_SCHEMA=public

# Aiven refuses unencrypted connections. `require` encrypts without validating
# the certificate chain and needs no extra files — the right default here.
DB_SSLMODE=require

# Only for certificate pinning: download Aiven's ca.pem, ship it with the image
# (or write it at boot) and switch DB_SSLMODE to verify-full.
# DB_SSLROOTCERT=/var/www/html/storage/certs/aiven-ca.pem

# Alternative to the six keys above: Aiven's "Service URI" in one value. Laravel
# parses it and it wins over DB_HOST/DB_PORT/etc. Note the scheme must be
# `pgsql://` (or `postgres://`), and %-encode any special characters.
# DB_URL=postgres://avnadmin:<password>@<host>:<port>/defaultdb?sslmode=require

# -----------------------------------------------------------------------------
# Mail — Brevo SMTP relay
# -----------------------------------------------------------------------------
# MAIL_USERNAME is the Brevo SMTP *login* (an email address shown under
# Brevo > SMTP & API > SMTP), and MAIL_PASSWORD is the SMTP *key* generated on
# that same page — NOT your Brevo account password.
# MAIL_FROM_ADDRESS must be a sender verified under Brevo > Senders, Domains & IPs,
# or Brevo silently drops the message.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=<your-brevo-smtp-login>
MAIL_PASSWORD=<your-brevo-smtp-key>
MAIL_FROM_ADDRESS=<verified-sender@your-domain>
MAIL_FROM_NAME="Airking Inventory System"

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# stderr, not a file: Render's filesystem is ephemeral, so storage/logs is lost
# on every deploy and invisible to `render logs`.
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Sessions, cache, queue
# -----------------------------------------------------------------------------
# `database` for all three: it needs no extra Render service, and it survives
# container restarts (the `file` driver would not).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# HTTPS-only cookies — Render terminates TLS at its edge.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database

# `sync` runs jobs inside the web request. Switch to `database` and add a Render
# Background Worker running `php artisan queue:work` once mail or exports get
# slow enough to hold up a response.
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids

FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Database backups
# -----------------------------------------------------------------------------
# BackupService shells out to pg_dump/psql here (postgresql-client ships both --
# see Dockerfile) and writes to local container disk, which Render replaces on
# every deploy -- same as it does for uploaded files. A local-only backup is
# real protection for one deploy cycle, not a disaster-recovery story.
#
# Set BACKUP_REMOTE_DISK=s3 to also copy every successful backup to an
# S3-compatible bucket, best-effort, right after it finishes locally. Works for
# real AWS S3 or Cloudflare R2 (R2 speaks the S3 API -- just point AWS_ENDPOINT
# at it and set AWS_USE_PATH_STYLE_ENDPOINT=true). Left empty, nothing changes:
# every backup stays local-only, exactly as if this block were not here.
#
# BACKUP_REMOTE_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=                     # R2 only: https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true  # R2 only

# -----------------------------------------------------------------------------
# Broadcasting (Laravel Reverb)
# -----------------------------------------------------------------------------
# Reverb is a long-running WebSocket server and does NOT run inside this web
# container -- it is a second Render service built from this same image, started
# with `php artisan reverb:start` instead of apache2-foreground. See
# docs/DEPLOY-RENDER.md, "Phase 6 - Deploy Reverb".
#
# Until that service exists, leave BROADCAST_CONNECTION=log: it keeps event
# dispatches from erroring, and the frontend falls back to a 60s poll.
#
# Once it exists, set BROADCAST_CONNECTION=reverb and fill in the block below.
# The three credentials must be IDENTICAL on this service and on the Reverb
# service -- they are how the two authenticate to each other. REVERB_HOST is the
# Reverb service's PUBLIC hostname (Render terminates TLS, so port 443/https
# regardless of the port Reverb binds internally).
BROADCAST_CONNECTION=log
# REVERB_APP_ID=airking
# REVERB_APP_KEY=<long random string, also set as REACT_APP_REVERB_APP_KEY on the frontend>
# REVERB_APP_SECRET=<long random string, server-side only, never in the frontend>
# REVERB_HOST=<your-reverb-service>.onrender.com
# REVERB_PORT=443
# REVERB_SCHEME=https

# -----------------------------------------------------------------------------
# External scheduler trigger
# -----------------------------------------------------------------------------
# This container has no cron, so `schedule:run` never fires on its own and
# analytics:restock, archive:auto, warranties:expire, archive:cleanup and
# ledger:drift-check never execute. Setting this token arms
# POST /api/scheduler/tick so a free external cron service can drive the
# scheduler once a minute; see docs/DEPLOY-RENDER.md, "Phase 7 - the scheduler".
#
# Empty or under 32 characters leaves the route 404ing -- it fails closed, so
# forgetting this cannot leave a world-callable trigger behind. Generate with
# `php artisan key:generate --show` and drop the "base64:" prefix. Do NOT reuse
# APP_KEY, and never put this in the frontend's environment.
# SCHEDULER_RUN_TOKEN=

# -----------------------------------------------------------------------------
# Password-reset SMS OTP
# -----------------------------------------------------------------------------
SMS_DRIVER=semaphore
SEMAPHORE_API_KEY=<your-semaphore-key>
SEMAPHORE_SENDER_NAME=SEMAPHORE

# -----------------------------------------------------------------------------
# Label printing
# -----------------------------------------------------------------------------
# Must match LABEL_WIDTH_MM / LABEL_HEIGHT_MM in
# frontend/src/admin/utils/barcodeLabel.js. DPI is the print head (203 = Zebra).
LABEL_WIDTH_MM=100
LABEL_HEIGHT_MM=25
LABEL_PRINTER_DPI=203

# -----------------------------------------------------------------------------
# Container behaviour (read by docker/entrypoint.sh)
# -----------------------------------------------------------------------------
# Render injects PORT itself; only set this for a local `docker run`.
# PORT=10000

# Migrate on container start. Keep false and use a Render Pre-Deploy Command of
# `php artisan migrate --force` — with more than one instance, two containers
# booting together would otherwise migrate concurrently.
RUN_MIGRATIONS=false
