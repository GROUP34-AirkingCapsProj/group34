APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Phones on the same Wi‑Fi need the API on 0.0.0.0, e.g. `composer run serve-lan` from this folder.
# Plain `php artisan serve` binds 127.0.0.1 only — mobile cannot reach it. Allow inbound TCP 8000 on Private networks in Windows Firewall if needed.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development. XAMPP installs ship MySQL, so most dev machines here run
# `mysql` with the airkingV5 database rather than the sqlite default below.
#
# PRODUCTION USES POSTGRESQL, NOT THIS. The Render + Aiven deployment sets
# DB_CONNECTION=pgsql; see .env.production.example for the full pgsql key set
# (host, non-default port, DB_SSLMODE=require). config/database.php defines the
# `pgsql` connection already, so only the environment differs.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=database/database.sqlite
# DB_USERNAME=root
# DB_PASSWORD=

# The canonical origin of the deployed frontend. Set this in production
# (e.g. https://airking.vercel.app); localhost origins are allowed by default.
FRONTEND_URL=

# Any *additional* origins allowed to call the API, comma-separated.
# Example: https://myapp.netlify.app,https://www.example.com
# Private LAN (192.168.x.x, 10.x.x.x) is allowed by default patterns in config/cors.php for dev.
CORS_ALLOWED_ORIGINS=

# For mobile / other devices on your network, bind Laravel (not only 127.0.0.1):
#   php artisan serve --host=0.0.0.0 --port=8000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Brevo SMTP relay. MAIL_USERNAME is the Brevo SMTP login (an email address),
# MAIL_PASSWORD is the Brevo SMTP key -- not your Brevo account password.
# MAIL_FROM_ADDRESS must be a sender verified under Brevo > Senders & IPs.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_brevo_smtp_login
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_FROM_ADDRESS="your_verified_sender@example.com"
MAIL_FROM_NAME="Airking Inventory System"

# Password-reset SMS OTP (Semaphore recommended for PH)
# Drivers: semaphore | twilio | vonage | log
SMS_DRIVER=semaphore
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE
# SEMAPHORE_API_URL=https://api.semaphore.co/api/v4/messages
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_FROM=AirKing

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=airking
REVERB_APP_KEY=airking-local-key
REVERB_APP_SECRET=airking-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Label stock. Must match LABEL_WIDTH_MM / LABEL_HEIGHT_MM in
# frontend/src/admin/utils/barcodeLabel.js. Which printer each location uses
# is set in the app, under System Configuration — not here.
# DPI is the print head: 203 is the common Zebra.
LABEL_WIDTH_MM=100
LABEL_HEIGHT_MM=25
LABEL_PRINTER_DPI=203

# --- One-off: moving local data into the deployed PostgreSQL database --------
# Used only by `php artisan data:transfer` (see docs/DATA-TRANSFER.md), which
# holds both databases open at once: DB_* above stays on local MySQL so
# development keeps working, and PG_* below points at Aiven.
#
# Copy these from the Aiven console (Service URI). The port is NOT 5432.
# Leave them blank unless you are running the transfer.
PG_HOST=
PG_PORT=
PG_DATABASE=defaultdb
PG_USERNAME=avnadmin
PG_PASSWORD=
PG_SSLMODE=require
